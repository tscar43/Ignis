# Copy to .env and fill in. .env is gitignored -- never commit it.
# Free key from https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_key_here
# Optional source-attributed current evacuation snapshot; see backend/api/README.md.
# Palisades historical demo is bundled and needs no key or environment setting.
# IGNIS_EVACUATIONS_PATH=path/to/evacuations.json

# Comma-separated frontend origins. Set in the server environment before startup.
# IGNIS_CORS_ORIGINS=https://your-frontend.example,http://localhost:5173
